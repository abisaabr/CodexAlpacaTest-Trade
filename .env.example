# Paper-only repo lock: do not commit real values, do not set LIVE_TRADING=true,
# and do not point APCA_API_BASE_URL at any live or custom trading endpoint.
# Fill only one credential family. Do not commit your real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

ALPACA_PAPER_TRADE=true
# Optional, but if set it must remain the Alpaca paper endpoint.
APCA_API_BASE_URL=https://paper-api.alpaca.markets

ALPACA_DATA_FEED=iex
DEFAULT_UNDERLYINGS=SPY,QQQ
DATA_ROOT=data
REPORTS_ROOT=reports
TZ=America/New_York
LOG_LEVEL=INFO
LIVE_TRADING=false
MAX_NOTIONAL_PER_TRADE=1000
MAX_OPEN_POSITIONS=3
MAX_ORDERS_PER_RUN=3
DRY_RUN=true
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
DISCORD_WEBHOOK_URL=
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional bearer token for private ntfy topics.
NTFY_ACCESS_TOKEN=

# Optional shared ownership lease for multi-machine standby safety.
# Point both machines at the same cloud-synced or network path.
# MULTI_TICKER_OWNERSHIP_ENABLED=true
# MULTI_TICKER_OWNERSHIP_LEASE_PATH=C:\Users\you\Google Drive\CodexAlpaca\leases\multi_ticker_portfolio.json
# MULTI_TICKER_OWNERSHIP_TTL_SECONDS=180
# MULTI_TICKER_MACHINE_LABEL=trading-laptop

# Optional email notifications. Gmail example:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=you@gmail.com
# EMAIL_PASSWORD=your-16-character-app-password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
# EMAIL_USE_STARTTLS=true
# EMAIL_SUBJECT_PREFIX=[CodexAlpaca]
